{
  "name": "erq",
  "version": "1.0.0",
  "description": "Erq - Ethiopian Freelance Marketplace",
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "vercel-build": "cd client && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "npm run install:all && npm run build",
    "migrate": "psql \"$POSTGRES_URL\" -f scripts/migration.sql"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "bcryptjs": "^2.4.3",
    "chapa-nodejs": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.46.0",
    "pg": "^8.13.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "vite": "^5.3.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
