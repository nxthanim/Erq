# ===================================================
#  Erq Marketplace — Production Environment Variables
# ===================================================
#  Copy this to .env.production and fill in values:
#    cp .env.production.example .env.production
# ===================================================

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database (SQLite — stored in data/ folder)
# No config needed — auto-creates

# Client URL (for CORS and Socket.io)
CLIENT_URL=https://gebeya.et

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-here

# NVIDIA API Key (for AI agents — optional, agents work offline without it)
NVIDIA_API_KEY=

# TeleBirr (if integrated)
# TELEBIRR_API_KEY=
# TELEBIRR_MERCHANT_ID=

# Email (for notifications)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
