# ============================================================================
# Erq Marketplace — Environment Variables
# ============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, set these with: vercel env add
# ============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# Vercel auto-injects POSTGRES_URL when you link a Neon database.
POSTGRES_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET="your-256-bit-random-secret-here"

# ── AI / NVIDIA API ───────────────────────────────────────────────────────
NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Domain (for CORS) ─────────────────────────────────────────────────────
CLIENT_URL="https://your-app.vercel.app"
DOMAIN="gebeya.et"
DOMAIN_PROTOCOL="https"

# ── Email (Password Reset & Fraud Alerts) ─────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
ADMIN_EMAIL="admin@yourdomain.com"

# ── Self-hosted Only ──────────────────────────────────────────────────────
NODE_ENV="production"
PORT=5000
HOST="0.0.0.0"
